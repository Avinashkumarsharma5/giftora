rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "gameplay2436rj@gmail.com" || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && incoming().role == "user";
      allow update: if isOwner(userId) && (
        !incoming().diff(existing()).affectedKeys().hasAny(["role"]) || isAdmin()
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Products Collection
    match /products/{productId} {
      allow read: if true; // Public access
      allow write: if isAdmin();
    }

    // 3. Categories Collection
    match /categories/{categoryId} {
      allow read: if true; // Public access
      allow write: if isAdmin();
    }

    // 4. Orders Collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 5. Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // Public feedback is readable by anyone
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // 6. Wishlist Collection (keyed by userId)
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 7. Coupons Collection
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
